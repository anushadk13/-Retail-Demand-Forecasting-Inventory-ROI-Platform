# DuckDB file used as the warehouse (default). Delete this line to use ./warehouse/retail.duckdb
WAREHOUSE_PATH=warehouse/retail.duckdb
# dbt target / schema the Python code reads from and writes to: dev | prod
WAREHOUSE_SCHEMA=dev
# Forecast horizon and number of rolling backtest folds
HORIZON=28
N_FOLDS=13   # 13 x 28 days = one full year, so every holiday is backtested
# Alerts: optional webhook (Teams / Slack / n8n). If unset, alerts are printed.
ALERT_WEBHOOK_URL=
DRIFT_WAPE_THRESHOLD=0.80
